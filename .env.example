# Copy this file to .env for a local try. .env is gitignored. Never commit real values.
#
# In a real deployment, the client secret and the application key live in a vault,
# and the addresses live in your own configuration system. This file only shows the names.
# Every value is empty on purpose. The demo pages name whatever is still empty and stop.

# --- Given by eToro in writing ---------------------------------------------------------

# Application id (client_id). Identifies your product to eToro.
# Empty means eToro's demo application (see src/config.js). Set your own here, together
# with the two callbacks below.
ETORO_CLIENT_ID=

# Your flow A callback, exactly as registered with eToro, character for character.
# Example shape: https://your-app.example.com/api/auth/callback
ETORO_REDIRECT_URI=

# Your flow C callback, exactly as registered with eToro.
# Example shape: https://your-app.example.com/api/auth/silent-login/callback
ETORO_FLOW_C_REDIRECT_URI=

# Flow B: the user-key call address eToro gave you for this environment.
ETORO_USER_KEY_URL=

# Flow B: the provider name eToro agreed with you for sub-account create.
ETORO_PROVIDER_NAME=

# Flow C: the eToro initiate page address eToro gave you for this environment.
ETORO_INITIATE_PAGE_URL=

# Optional: only if you agreed with eToro to report events.
ETORO_PARTNER_EVENTS_URL=
ETORO_EVENT_TYPE=

# --- Given by eToro through the agreed secret channel. Keep in a vault. ----------------

ETORO_CLIENT_SECRET=
ETORO_APP_KEY=

# --- eToro hosts ------------------------------------------------------------------------
# Leave every line below empty to use the production hosts from the partner brief.
# To use another environment, set every line below with the hosts eToro gave you for
# that environment. Do not mix environments. A partial set stops every journey.

ETORO_AUTHORIZE_URL=
ETORO_TOKEN_URL=
ETORO_REVOKE_URL=
ETORO_JWKS_URL=
ETORO_ISSUER=
ETORO_SUB_ACCOUNTS_URL=
ETORO_PARTNER_LOGIN_TOKEN_URL=
